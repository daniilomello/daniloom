{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop:dev": "npm run desktop:native && vite build && electron desktop",
    "desktop:start": "electron desktop",
    "desktop:build": "npm run desktop:icons && npm run desktop:native && vite build && electron-builder --config electron-builder.config.cjs --mac",
    "desktop:build:win": "npm run desktop:icons && vite build && electron-builder --config electron-builder.config.cjs --win",
    "desktop:pack": "npm run desktop:icons && npm run desktop:native && vite build && electron-builder --config electron-builder.config.cjs --mac --dir",
    "desktop:test": "node --test desktop/*.test.cjs && tsx --test src/desktop/*.test.ts",
    "desktop:icons": "node scripts/build-desktop-icons.mjs",
    "desktop:native": "node scripts/build-desktop-native.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@heroui/react": "^3.2.6",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "undici": "^8.5.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
